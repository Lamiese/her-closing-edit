---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for item in collections.all %}{% if not item.data.noindex and not item.data.draft and item.url and not item.url.startsWith("/admin") %}
  <url><loc>{{ item.url | absUrl(site.url) }}</loc><lastmod>{{ (item.data.updated or item.date) | isoDate }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
