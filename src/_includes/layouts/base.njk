<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (seoTitle or title) %}
  {%- set fullTitle = pageTitle + " | " + site.name if pageTitle and page.url != "/" else site.name + " | " + site.tagline %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ description }}">
  {%- set canonical = page.url | absUrl(site.url) %}
  <link rel="canonical" href="{{ canonical }}">
  {%- if noindex or draft %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- if site.searchConsoleVerification %}
  <meta name="google-site-verification" content="{{ site.searchConsoleVerification }}">
  {%- endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle or site.name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
  <meta property="og:locale" content="en_GB">
  {%- if image %}<meta property="og:image" content="{{ image | absUrl(site.url) }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#F5EFE7">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  {%- if breadcrumbs %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site.url }}/"}{% for crumb in breadcrumbs %},{"@type":"ListItem","position":{{ loop.index + 1 }},"name":{{ crumb.name | jsonify | safe }},"item":"{{ crumb.url | absUrl(site.url) }}"}{% endfor %}]}
  </script>
  {%- endif %}
  {%- if isArticle %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Article","headline":{{ title | jsonify | safe }},"description":{{ description | jsonify | safe }},"datePublished":"{{ date | isoDate }}","dateModified":"{{ (updated or date) | isoDate }}","mainEntityOfPage":"{{ canonical }}","author":{"@type":"Person","name":"{{ site.founder }}","url":"{{ site.url }}/about/"},"publisher":{"@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}/","logo":{"@type":"ImageObject","url":"{{ site.url }}/favicon.svg"}}}
  </script>
  {%- endif %}
  {%- if page.url == "/" %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}/","logo":"{{ site.url }}/favicon.svg","founder":{"@type":"Person","name":"{{ site.founder }}"}}
  </script>
  {%- endif %}
  <script>window.TCE = { ga4Id: "{{ site.ga4Id }}" };</script>
  <script src="/assets/js/main.js" defer></script>
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {%- if draft %}
    <div class="draft-notice" role="note"><div class="wrap">This page is a template awaiting your details. It is hidden from search engines until completed.</div></div>
    {%- endif %}
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/consent.njk" %}
  {%- if trackEvent %}
  <script>document.addEventListener("DOMContentLoaded", function () { window.tceTrack && window.tceTrack({{ trackEvent | jsonify | safe }}, {{ (trackParams or {}) | jsonify | safe }}); });</script>
  {%- endif %}
</body>
</html>
