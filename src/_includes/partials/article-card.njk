<article class="article-card">
  {%- if post.data.image %}
  <img src="{{ post.data.image }}" alt="{{ post.data.imageAlt }}" loading="lazy" width="800" height="560">
  {%- else %}
  <div class="article-card-art art-{{ loop.index0 % 3 }}" aria-hidden="true"><span>{{ post.data.cardWord }}</span></div>
  {%- endif %}
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p>{{ post.data.excerpt }}</p>
</article>
