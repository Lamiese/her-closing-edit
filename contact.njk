---
layout: layouts/base.njk
title: Contact
seoTitle: "Contact Her Closing Edit"
description: "Get in touch with Her Closing Edit about resources, collaborations or questions about the site."
breadcrumbs: [{ name: "Contact", url: "/contact/" }]
---
<div class="wrap">{% include "partials/breadcrumbs.njk" %}</div>
<div class="page-body wrap-narrow">
  <h1>Contact</h1>
  <p class="lede">Questions about the resources, a collaboration idea or something on the site? Send a message and I’ll reply by email.</p>
  <p class="form-note">Please note I can’t offer personal job placement or review individual job offers.</p>
  <form class="contact-form" name="contact" method="POST" action="/thank-you/contact/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="contact">
    <p class="visually-hidden"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>
    <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" required autocomplete="name"></div>
    <div class="field"><label for="c-email">Email address</label><input id="c-email" type="email" name="email" required autocomplete="email"></div>
    <div class="field">
      <label for="c-topic">What’s it about?</label>
      <select id="c-topic" name="topic">
        <option>A question about a resource</option>
        <option>An order or download</option>
        <option>Collaboration or press</option>
        <option>Something else</option>
      </select>
    </div>
    <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" rows="6" required></textarea></div>
    <button class="btn" type="submit">Send message</button>
    <p class="form-note">Your details are only used to reply to you. See our <a href="/privacy-policy/">privacy policy</a>.</p>
  </form>
</div>
